# Never commit a populated .env file. Paper trading only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_WEBHOOK_URL=https://your-service.example
TELEGRAM_WEBHOOK_SECRET=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# Free/default Alpaca market-data feed. Use sip only with an entitled account.
ALPACA_DATA_FEED=iex

# International analysis: official Twelve Data provider and optional yfinance fallback.
TWELVE_DATA_API_KEY=
ENABLE_YFINANCE_FALLBACK=false
GLOBAL_MARKET_DATA_PROVIDER=twelve_data
MARKET_DATA_CACHE_TTL_SECONDS=60
INSTRUMENT_SEARCH_CACHE_TTL_SECONDS=300
PROVIDER_REQUEST_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=2
